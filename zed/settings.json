// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "show_edit_predictions": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": true,
    "anthropic_retention": false,
  },
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "fixed",
    "enabled": true,
    "line_width": 1,
  },
  "file_finder": {
    "include_ignored": "all",
  },
  "title_bar": {
    "show_branch_status_icon": false,
  },
  "proxy": "",
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "left",
  },
  "which_key": {
    "enabled": true,
    "delay_ms": 200,
  },
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "copilot",
    "disabled_globs": [],
  },
  "terminal": {
    "font_family": "VictorMono Nerd Font",
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Soft Charmed Icons",
    "dark": "Soft Charmed Icons"
  },
  "agent_ui_font_size": 17.0,
  "cursor_blink": false,
  "helix_mode": true,
  "base_keymap": "Emacs",
  "git_panel": {
    "dock": "right",
  },
  "project_panel": {
    "dock": "right",
  },
  "agent": {
    "sandbox_permissions": {
      "network_hosts": [
        "raw.githubusercontent.com"
      ]
    },
    "default_width": 480.0,
    "terminal_init_command": "claude",
    "default_profile": "write",
    "dock": "right",
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "gpt-5.6-terra",
    },
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-5",
    },
  },
  "vim_mode": false,
  "ui_font_size": 16.0,
  "buffer_font_family": "VictorMono Nerd Font",
  "buffer_font_weight": 400.0,
  "buffer_font_size": 15.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Rosé Pine"
  },
  // "experimental.theme_overrides": {
  //   "border": "#111111",
  //   "border.variant": "#333333",
  // },
  "autosave": "on_focus_change",
  "lsp": {
    "deno": {
      "settings": {
        "deno": {
          "enable": true,
        },
      },
    },
    "kotlin-lsp": {
      "binary": {
        "path": "/opt/homebrew/bin/kotlin-lsp",
        "arguments": ["--stdio"],
      },
    },
  },
  "languages": {
    "Swift": {
      "enable_language_server": true,
      "language_servers": ["sourcekit-lsp"],
      "formatter": "language_server",
      "format_on_save": "on",
      "tab_size": 4,
    },
    "Dart": {
      // not working
      "enable_language_server": true,
      "language_servers": ["dart"],
      "formatter": "language_server",
      "format_on_save": "on",
    },
    "TypeScript": {
      "language_servers": [
        "deno",
        "!typescript-language-server",
        "!vtsls",
        "!eslint",
      ],
      "formatter": "language_server",
    },
    "TSX": {
      "language_servers": [
        "deno",
        "!typescript-language-server",
        "!vtsls",
        "!eslint",
      ],
      "formatter": "language_server",
    },
    "Odin": {
      "formatter": "language_server",
    },
    "Kotlin": {
      "language_servers": ["kotlin-lsp", "!kotlin-language-server"],
    },
  },
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "relative_line_numbers": "enabled",
  "tab_bar": {
    "show": false,
  },
  "format_on_save": "on",
}
