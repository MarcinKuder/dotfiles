// Doom Emacs-style keybindings for Zed
// Based on https://gist.github.com/oca159/0b480ed6555056418905b6e59af33674
[
  // Global workspace bindings
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-/": "workspace::ToggleBottomDock",
      // Doom: M-x
      "alt-x": "command_palette::Toggle",
    },
  },
  // Window navigation (evil-style ctrl+hjkl)
  {
    "context": "Dock || Terminal || Editor",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
    },
  },
  {
    "context": "GitPanel",
    "bindings": {
      "q": "git_panel::Close",
    },
  },
  {
    "context": "AgentPanel",
    "bindings": {
      "ctrl-\\": "workspace::ToggleRightDock",
      "cmd-k": "workspace::ToggleRightDock",
    },
  },
  // Project panel (treemacs/netrw style)
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "A": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "x": "project_panel::Cut",
      "c": "project_panel::Copy",
      "y": "project_panel::Copy",
      "p": "project_panel::Paste",
      "q": "workspace::ToggleLeftDock",
      ":": "command_palette::Toggle",
      "%": "project_panel::NewFile",
      "/": "project_panel::NewSearchInDirectory",
      "enter": "project_panel::OpenPermanent",
      "escape": "project_panel::ToggleFocus",
      "h": "project_panel::CollapseSelectedEntry",
      "j": "menu::SelectNext",
      "k": "menu::SelectPrevious",
      "l": "project_panel::ExpandSelectedEntry",
      "o": "project_panel::OpenPermanent",
      "shift-d": "project_panel::Delete",
      "shift-r": "project_panel::Rename",
      "t": "project_panel::OpenPermanent",
      "v": "project_panel::OpenPermanent",
      "shift-g": "menu::SelectLast",
      "g g": "menu::SelectFirst",
      "-": "project_panel::SelectParent",
      "ctrl-6": "pane::AlternateFile",
      // Doom style
      "R": "project_panel::RevealInFinder",
      "H": "project_panel::ToggleExcludedFiles",
    },
  },
  // Empty pane bindings
  {
    "context": "EmptyPane || SharedScreen",
    "bindings": {
      "space space": "file_finder::Toggle",
      "space f n": "workspace::NewFile",
      "space f p": "projects::OpenRecent",
      "space s g": "workspace::NewSearch",
      "space q q": "zed::Quit",
      "space .": "file_finder::Toggle",
      "space p p": "projects::OpenRecent",
    },
  },
  // Main Doom Emacs SPC leader bindings
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      // ==================== FILE (SPC f) ====================
      "space f f": "file_finder::Toggle",
      "space f n": "workspace::NewFile",
      "space f p": "projects::OpenRecent",
      "space f r": "file_finder::Toggle", // recent files
      "space f s": "workspace::Save",
      "space f S": "workspace::SaveAll",
      "space f y": "editor::CopyPath",
      "space f Y": "editor::CopyRelativePath",
      "space f R": "project_panel::Rename",
      "space f D": "project_panel::Delete",

      // ==================== BUFFER (SPC b) ====================
      "space b b": "pane::AlternateFile",
      "space b d": "pane::CloseActiveItem",
      "space b k": "pane::CloseActiveItem",
      "space b K": "pane::CloseAllItems",
      "space b n": "workspace::NewFile",
      "space b p": "pane::ActivatePreviousItem",
      "space b N": "pane::ActivateNextItem",
      "space b q": "pane::CloseOtherItems",
      "space b s": "workspace::Save",
      "space b S": "workspace::SaveAll",
      "space b r": "pane::RevealInProjectPanel",
      "space b l": "pane::ActivateLastItem",
      "space b [": "pane::ActivatePreviousItem",
      "space b ]": "pane::ActivateNextItem",
      "space ,": "tab_switcher::Toggle",
      "space -": "pane::ActivatePreviousItem",
      "space `": "pane::AlternateFile",

      // ==================== CODE (SPC c) ====================
      "space c a": "editor::ToggleCodeActions",
      "space c f": "editor::Format",
      "space c r": "editor::Rename",
      "space c x": "editor::ToggleCodeActions",
      "space c d": "editor::GoToDefinition",
      "space c D": "editor::GoToDeclaration",
      "space c i": "editor::GoToImplementation",
      "space c t": "editor::GoToTypeDefinition",
      "space c k": "editor::Hover",
      "space c j": "editor::MoveToEnclosingBracket",

      // ==================== SEARCH (SPC s) ====================
      "space s b": "vim::Search",
      "space s B": "buffer_search::Deploy",
      "space s d": "diagnostics::Deploy",
      "space s g": "workspace::NewSearch",
      "space s p": "workspace::NewSearch",
      "space s s": "outline::Toggle",
      "space s S": "project_symbols::Toggle",
      "space s i": "outline::Toggle",
      "space s I": "project_symbols::Toggle",
      "space s w": "buffer_search::Deploy",
      "space s W": "pane::DeploySearch",
      "space s r": "search::SelectNextMatch",
      "space /": "workspace::NewSearch",
      "space *": "pane::DeploySearch",

      // ==================== GIT (SPC g) ====================
      "space g g": [
        "task::Spawn",
        {
          "task_name": "lazygit",
          "reveal_target": "center",
        },
      ],
      "space g b": "git::Blame",
      "space g B": "git::Blame",
      "space g d": "git::Diff",
      "space g D": "editor::ExpandAllDiffHunks",
      "space g r": "git::Restore",
      "space g R": "git::RestoreFile",
      "space g s": "git::Stage",
      "space g S": "git::StageFile",
      "space g u": "git::Unstage",
      "space g U": "git::UnstageFile",
      "space g h d": "editor::ExpandAllDiffHunks",
      "space g h D": "git::Diff",
      "space g h r": "git::Restore",
      "space g h R": "git::RestoreFile",
      "space g h s": "git::Stage",
      "space g h S": "git::StageFile",
      "space g h u": "git::Unstage",
      "space g h n": "editor::GoToHunk",
      "space g h p": "editor::GoToPreviousHunk",

      // ==================== PROJECT (SPC p) ====================
      "space p p": "projects::OpenRecent",
      "space p f": "file_finder::Toggle",
      "space p s": "workspace::NewSearch",
      "space p t": "project_panel::ToggleFocus",
      "space p a": "workspace::AddFolderToProject",
      "space p r": "recent_projects::OpenRecent",

      // ==================== WINDOW (SPC w) ====================
      "space w s": "pane::SplitDown",
      "space w v": "pane::SplitRight",
      "space w h": "workspace::ActivatePaneLeft",
      "space w l": "workspace::ActivatePaneRight",
      "space w k": "workspace::ActivatePaneUp",
      "space w j": "workspace::ActivatePaneDown",
      "space w c": "pane::CloseAllItems",
      "space w d": "pane::CloseAllItems",
      "space w q": "pane::CloseAllItems",
      "space w w": "workspace::ActivateNextPane",
      "space w W": "workspace::ActivatePreviousPane",
      "space w o": "workspace::CloseInactiveTabsAndPanes",
      "space w m": "workspace::ToggleZoom",
      "space w =": "workspace::ResetZoom",
      "space w H": "workspace::SwapPaneLeft",
      "space w L": "workspace::SwapPaneRight",
      "space w K": "workspace::SwapPaneUp",
      "space w J": "workspace::SwapPaneDown",
      "space |": "pane::SplitRight",
      "space _": "pane::SplitDown",

      // ==================== OPEN (SPC o) ====================
      "space o p": "project_panel::ToggleFocus",
      "space o t": "workspace::ToggleBottomDock",
      "space o T": "terminal_panel::ToggleFocus",
      "space o a": "agent::ToggleFocus",
      "space o d": "diagnostics::Deploy",
      "space o g": "git_panel::ToggleFocus",

      // ==================== TOGGLE (SPC t) ====================
      "space t l": "editor::ToggleLineNumbers",
      "space t w": "editor::ToggleSoftWrap",
      "space t i": "editor::ToggleInlayHints",
      "space t h": "editor::ToggleInlayHints",
      "space t f": "workspace::ToggleLeftDock",
      "space t F": "workspace::ToggleCenteredLayout",
      "space t z": "workspace::ToggleZoom",

      // ==================== UI (SPC u) ====================
      "space u i": "editor::ToggleInlayHints",
      "space u w": "editor::ToggleSoftWrap",
      "space u l": "editor::ToggleLineNumbers",
      "space u z": "workspace::ToggleZoom",

      // ==================== HELP (SPC h) ====================
      "space h k": "zed::OpenKeymap",
      "space h K": "zed::OpenDefaultKeymap",
      "space h s": "zed::OpenSettings",
      "space h S": "zed::OpenDefaultSettings",
      "space h t": "theme_selector::Toggle",
      "space h d": "zed::OpenDocumentation",
      "space h r": "zed::ReloadExtensions",

      // ==================== QUIT (SPC q) ====================
      "space q q": "zed::Quit",
      "space q Q": "zed::Quit",
      "space q r": "workspace::Reload",

      // ==================== AI/ASSISTANT (SPC a) ====================
      "space a a": "agent::ToggleFocus",
      "space a e": "assistant::InlineAssist",
      "space a t": "workspace::ToggleRightDock",
      "space a c": "assistant::NewContext",
      "ctrl-\\": "workspace::ToggleRightDock",
      "cmd-l": "assistant::InlineAssist",

      // ==================== NOTES/MARKDOWN (SPC m) ====================
      "space m p": "markdown::OpenPreview",
      "space m P": "markdown::OpenPreviewToTheSide",

      // ==================== DOCKS (SPC d) ====================
      "space d c": "workspace::CloseAllDocks",

      // ==================== QUICK ACCESS ====================
      "space space": "file_finder::Toggle",
      "space .": "file_finder::Toggle",
      "space :": "command_palette::Toggle",
      "space ;": "command_palette::Toggle",
      "space e": "project_panel::ToggleFocus",
      "space E": "vim::ToggleProjectPanelFocus",
      "space t": "workspace::ToggleBottomDock",

      // ==================== TAB NUMBERS ====================
      "space 1": ["pane::ActivateItem", 0],
      "space 2": ["pane::ActivateItem", 1],
      "space 3": ["pane::ActivateItem", 2],
      "space 4": ["pane::ActivateItem", 3],
      "space 5": ["pane::ActivateItem", 4],
      "space 6": ["pane::ActivateItem", 5],
      "space 7": ["pane::ActivateItem", 6],
      "space 8": ["pane::ActivateItem", 7],
      "space 9": ["pane::ActivateItem", 8],
      "space 0": "pane::ActivateLastItem",

      // ==================== BRACKET NAVIGATION ====================
      "] b": "pane::ActivateNextItem",
      "[ b": "pane::ActivatePreviousItem",
      "] h": "editor::GoToHunk",
      "[ h": "editor::GoToPreviousHunk",
      "] c": "editor::GoToHunk",
      "[ c": "editor::GoToPreviousHunk",
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
      "] e": "editor::GoToDiagnostic",
      "[ e": "editor::GoToPreviousDiagnostic",
      "] q": "editor::MoveToStartOfNextExcerpt",
      "[ q": "editor::MoveToStartOfExcerpt",
      "] f": "editor::MoveToEndOfNextFunction",
      "[ f": "editor::MoveToBeginningOfPreviousFunction",
      "] ]": "editor::MoveToEndOfNextFunction",
      "[ [": "editor::MoveToBeginningOfPreviousFunction",
    },
  },
  // Visual mode bindings
  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !VimObject",
    "bindings": {
      "shift-j": "editor::MoveLineDown",
      "shift-k": "editor::MoveLineUp",
      // Doom visual bindings
      "g c": "editor::ToggleComments",
      "<": "editor::Outdent",
      ">": "editor::Indent",
    },
  },
  // g-prefix bindings (go-to commands)
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      "g d": "editor::GoToDefinition",
      "g D": "editor::GoToDeclaration",
      "g i": "editor::GoToImplementation",
      "g y": "editor::GoToTypeDefinition",
      "g r": "editor::FindAllReferences",
      "g h": "editor::Hover",
      "g s": "vim::PushSneak",
      "g S": "vim::PushSneakBackward",
      // Comments
      "g c c": "editor::ToggleComments",
      "g c": "editor::ToggleComments",
    },
  },
  // Normal mode specific
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      // K for documentation (Doom style)
      "shift-k": "editor::Hover",
      // Quick save
      "ctrl-s": "workspace::Save",
    },
  },
  // Center cursor on scroll (Doom style)
  {
    "context": "VimControl && !menu",
    "bindings": {
      "ctrl-d": ["workspace::SendKeystrokes", "ctrl-d z z"],
      "ctrl-u": ["workspace::SendKeystrokes", "ctrl-u z z"],
      "n": ["workspace::SendKeystrokes", "n z z z v"],
      "shift-n": ["workspace::SendKeystrokes", "shift-n z z z v"],
      "shift-g": ["workspace::SendKeystrokes", "shift-g z z"],
      // Scroll bindings
      "ctrl-e": "editor::ScrollDown",
      "ctrl-y": "editor::ScrollUp",
    },
  },
  // Fold bindings (z prefix)
  {
    "context": "Editor && VimControl && !VimWaiting && !menu",
    "bindings": {
      "z a": "editor::ToggleFold",
      "z c": "editor::Fold",
      "z o": "editor::UnfoldLines",
      "z C": "editor::FoldAll",
      "z O": "editor::UnfoldAll",
      "z M": "editor::FoldAll",
      "z R": "editor::UnfoldAll",
      "z m": "editor::FoldSelectedRanges",
      "z r": "editor::UnfoldLines",
    },
  },
  // d-operator context for git hunks
  {
    "context": "vim_operator == d",
    "bindings": {
      "o": "editor::ExpandAllDiffHunks",
      "r": "git::Restore",
    },
  },
  // Sneak bindings
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "s": "vim::PushSneak",
      "S": "vim::PushSneakBackward",
    },
  },
  // Text object: any bracket with 'b'
  {
    "context": "vim_operator == a || vim_operator == i || vim_operator == cs",
    "bindings": {
      "b": "vim::AnyBrackets",
    },
  },
  // Insert mode bindings
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // Emacs-style insert mode bindings
      "ctrl-a": "editor::MoveToBeginningOfLine",
      "ctrl-e": "editor::MoveToEndOfLine",
      "ctrl-k": "editor::DeleteToEndOfLine",
      "ctrl-w": "editor::DeleteToPreviousWordStart",
      "ctrl-u": "editor::DeleteToBeginningOfLine",
      // Quick escape
      "j k": ["workspace::SendKeystrokes", "escape"],
      "j j": ["workspace::SendKeystrokes", "escape"],
    },
  },
  // Command/ex mode
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      // Quick command palette (like :)
      ";": "command_palette::Toggle",
    },
  },
]
